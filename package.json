{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "html-colors",
  "title": "HTML Colors",
  "description": "Search through pallettes of standard HTML colors. Offers basic + extended set. Search by name or browse by looking at the color itself.",
  "icon": "icon.png",
  "author": "almatkai",
  "contributors": ["Synacek"],
  "categories": ["Developer Tools", "Design Tools"],
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "commands": [
    {
      "name": "html-color",
      "title": "Search HTML Colors",
      "description": "Quickly find HTML colors by name, hex, or RGB. Supports fuzzy search with typos and shows both basic and extended color sets.",
      "mode": "view",
      "platforms": ["macOS", "Windows"]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.5",
    "fuse.js": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.html-colors",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": ["macos", "windows"],
    "repository": "https://github.com/almatkai/html-colors",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/html-colors",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    },
    "linuxStatus": "coming-soon"
  }
}
